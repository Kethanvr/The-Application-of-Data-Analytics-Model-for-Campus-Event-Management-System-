# Copy this file to .env and fill in the values

# MongoDB connection string
# Local:      mongodb://localhost:27017/eventwebsite
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventwebsite?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventwebsite?retryWrites=true&w=majority

# Django secret key — change this in production!
SECRET_KEY=django-insecure-change-me-in-production

# Set to "true" on Render (enables DEBUG=False, WhiteNoise, etc.)
# RENDER=true

# Automatically set by Render
# RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com
